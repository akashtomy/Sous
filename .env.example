# Accounts & sharing (Supabase). Leave empty to run in single-device mode.
# Find both in your Supabase project: Project Settings → API (or the "Connect" dialog).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Usernames are stored as <username>@<this domain> in Supabase Auth. No mail is ever sent to it.
# Keep the default unless you own another domain you prefer; don't change it after people sign up.
EXPO_PUBLIC_USERNAME_EMAIL_DOMAIN=users.sous.app

# Feature flags
EXPO_PUBLIC_FEATURE_GOOGLE_SIGNIN=false
